# App
APP_URL="http://localhost:3000"

# Database (dev: SQLite)
DATABASE_URL="file:./dev.db"

# Auth — Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-secure-random-base64-secret"

# Master Encryption Key — Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY="replace-with-a-secure-32-byte-base64-key"

# Video Provider: gemini | replicate | fal | procedural
VIDEO_PROVIDER="gemini"

# Storage: local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# Optional Enquiry & Contact Notifications (SMTP)
ENQUIRY_TO_EMAIL="admin@example.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="admin@example.com"
SMTP_PASS="your-app-password"
